From 20a454c75481ac7731fa494dff935e8cd5eed516 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?John=20T=C3=B6rnblom?= <john.tornblom@gmail.com>
Date: Fri, 6 Nov 2026 23:16:49 +0000
Subject: [PATCH 5/5] Keep the in-RAM savestate in memory without fmemopen()

fmemopen() isn't available everywhere (Windows, Android before API 23,
PS4), and platforms without it saved the in-RAM savestate to a file.
Add a memory-backed hostfs::File and use it on all platforms. This also
removes the 32 MB static buffer.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01EVpxQm2qgi1H2nU3iig9Gg
---
 core/nullDC.cpp      | 26 +++----------
 core/oslib/storage.h | 90 ++++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 95 insertions(+), 21 deletions(-)

diff --git a/core/nullDC.cpp b/core/nullDC.cpp
index 280ba51..e68d615 100644
--- a/core/nullDC.cpp
+++ b/core/nullDC.cpp
@@ -27,21 +27,7 @@
 static std::string lastStateFile;
 static time_t lastStateTime;
 
-#if defined(__ANDROID__)
-    #include <android/api-level.h>
-    // fmemopen was added in Marshmallow (API 23)
-    #if __ANDROID_API__ >= 23
-        #define HAS_FMEMOPEN
-    #endif
-#elif defined(__linux__) || defined(__APPLE__) || defined(__FreeBSD__) || defined(__GLIBC__)
-    // Standard POSIX platforms usually have fmemopen
-    #define HAS_FMEMOPEN
-#endif
-
-#ifdef HAS_FMEMOPEN
-const u32 QUICKSAVE_DEFAULT_SIZE = 32 * 1024 * 1024; // 32 MB
-static u8 quicksave_buf[QUICKSAVE_DEFAULT_SIZE] = {0};
-#endif
+static std::vector<u8> ramSavestate;
 
 struct SavestateHeader
 {
@@ -201,15 +187,14 @@ void dc_savestate(int index, const u8 *pngData, u32 pngSize)
 
 	hostfs::File *f = nullptr;
 	std::string filename = "";
-#ifdef HAS_FMEMOPEN
 	if (index == -2)
 	{
 		// in-ram savestate
 		filename = "RAM";
-		f = new hostfs::StdFile(fmemopen(quicksave_buf, QUICKSAVE_DEFAULT_SIZE, "wb"));
+		ramSavestate.clear();
+		f = new hostfs::MemFile(ramSavestate);
 	}
 	else
-#endif
 	{
 		// regular file savestate
 		filename = hostfs::getSavestatePath(index, true);
@@ -269,15 +254,14 @@ void dc_loadstate(int index)
 
 	hostfs::File *f = nullptr;
 	std::string filename = "";
-#ifdef HAS_FMEMOPEN
 	if (index == -2)
 	{
 		// in-ram savestate
 		filename = "RAM";
-		f = new hostfs::StdFile(fmemopen(quicksave_buf, QUICKSAVE_DEFAULT_SIZE, "rb"));
+		if (!ramSavestate.empty())
+			f = new hostfs::MemFile(ramSavestate);
 	}
 	else
-#endif
 	{
 		// regular file savestate
 		filename = hostfs::getSavestatePath(index, false);
diff --git a/core/oslib/storage.h b/core/oslib/storage.h
index d1adfe5..a84f416 100644
--- a/core/oslib/storage.h
+++ b/core/oslib/storage.h
@@ -19,6 +19,8 @@
 #pragma once
 #include "types.h"
 
+#include <algorithm>
+#include <cstring>
 #include <vector>
 
 namespace hostfs
@@ -117,6 +119,94 @@ public:
 	}
 };
 
+class MemFile : public File
+{
+	std::vector<u8>& data;
+	size_t pos = 0;
+	bool atEof = false;
+
+public:
+	MemFile(std::vector<u8>& data)
+		: data(data)
+	{}
+
+	size_t read(void* buffer, size_t size, size_t count) override
+	{
+		if (size == 0 || count == 0)
+			return 0;
+		size_t avail = pos < data.size() ? data.size() - pos : 0;
+		size_t len = std::min(size * count, avail);
+		if (len < size * count)
+			atEof = true;
+		if (len > 0)
+			memcpy(buffer, &data[pos], len);
+		pos += len;
+		return len / size;
+	}
+
+	size_t write(const void* buffer, size_t size, size_t count) override
+	{
+		size_t len = size * count;
+		if (len == 0)
+			return 0;
+		if (pos + len > data.size())
+			data.resize(pos + len);
+		memcpy(&data[pos], buffer, len);
+		pos += len;
+		return count;
+	}
+
+	s64 tell() override
+	{
+		return pos;
+	}
+
+	int seek(s64 offset, int whence) override
+	{
+		s64 base = whence == SEEK_SET ? 0 : whence == SEEK_CUR ? (s64)pos : (s64)data.size();
+		if (base + offset < 0)
+			return -1;
+		pos = base + offset;
+		atEof = false;
+		return 0;
+	}
+
+	char* gets(char* str, int count) override
+	{
+		int i = 0;
+		while (i < count - 1)
+		{
+			if (pos >= data.size())
+			{
+				atEof = true;
+				break;
+			}
+			str[i++] = data[pos++];
+			if (str[i - 1] == '\n')
+				break;
+		}
+		if (i == 0)
+			return nullptr;
+		str[i] = '\0';
+		return str;
+	}
+
+	s64 size() override
+	{
+		return data.size();
+	}
+
+	int eof() override
+	{
+		return atEof;
+	}
+
+	int error() override
+	{
+		return 0;
+	}
+};
+
 class StorageException : public FlycastException
 {
 public:
